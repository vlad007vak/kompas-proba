# Skopiuj ten plik do .env.local i uzupełnij. .env.local NIE trafia do gita.
# Na Vercelu te same zmienne ustaw w: Project → Settings → Environment Variables.

# Kolejność prób dostawców (pierwszy działający odpowiada)
AI_PROVIDER_ORDER=groq,gemini,ollama

# Groq – https://console.groq.com/keys (darmowy plan, limity na organizację)
# Kilka kluczy (np. od różnych osób z zespołu) podaj po przecinku: klucz1,klucz2
GROQ_API_KEY=
# Lista modeli: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini – https://aistudio.google.com/apikey (darmowy plan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama – tylko lokalnie (awaryjnie, gdy nie ma internetu). Puste = wyłączone.
# Najpierw: ollama pull <model>
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
